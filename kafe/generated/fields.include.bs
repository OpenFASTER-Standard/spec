    <tr><td class="col-num">3<td><code>generalData/LegalForm</code><td class="col-req">Optional<td>Enum (<a href="#enum-rechtsformen">Rechtsformen</a>): <code>NATP</code>, <code>KAPG</code>, <code>SOJP</code>, <code>INVF</code>, <code>PENF</code>, <code>GSTF</code>, <code>HHTR</code>, <code>PGES</code><td class="long">Legal form</tr>
    <tr><td class="col-num">4<td><code>generalData/SpecificLegalForm</code><td class="col-req">Required<td>Text (max 80)<td class="long">specific legal form</tr>
