<h3 id="enum-kapitalertragart">KapitalertragArt</h3>

<p><em>Used in:</em> <code>4 Income.CapitalIncome</code></p>

<table class="complex data longlastcol enum-table">
  <colgroup>
    <col style="width:18%">
    <col style="width:82%">
  </colgroup>
  <thead><tr><th>Value<th>Meaning</tr></thead>
  <tbody>
    <tr><td><code>DIVIDENDEN</code><td class="long">Dividends from listed shares</tr>
    <tr><td><code>AUSSCH_KAPG</code><td class="long">Distributions from non-listed company (e.g. GmbH)</tr>
    <tr><td><code>GENUSSR_ML</code><td class="long">Income from profit participation rights with participation in liquidation proceeds</tr>
