    <col style="width:20%">
    <col style="width:50%">
  </colgroup>
  <thead><tr><th>Field<th class="col-req">Requiredness<th>Type / Allowed values<th>Description</tr></thead>
  <tbody>
    <tr><td><code>StatusCode</code><td class="col-req">Required<td>Text (max 4)<td class="long">Statuscode des Validierungsergebnisses (0000 = OK).</tr>
    <tr><td><code>Hinweis</code><td class="col-req">Required<td>Text<td class="long">Hinweis zum Validierungsergebnis.</tr>
  </tbody>
</table>
