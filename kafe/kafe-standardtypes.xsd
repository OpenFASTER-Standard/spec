	<xs:complexType name="Zwecke_Struct">
		<xs:annotation>
			<xs:documentation xml:lang="de">Angaben zu den steuerbegünstigten Zwecken</xs:documentation>
			<xs:documentation xml:lang="en">Information on the tax-privileged purposes</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Gemeinnuetzig" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Die beschränkt steuerpflichtige Person verfolgt gemeinnützige Zwecke (§ 52 AO).</xs:documentation>
					<xs:documentation xml:lang="en">The person with limited tax liability pursues public benefit purposes (section 52 of the Fiscal Code).
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mildtaetig" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Die beschränkt steuerpflichtige Person verfolgt mildtätige Zwecke (§ 53 AO).</xs:documentation>
					<xs:documentation xml:lang="en">The person with limited tax liability pursues charitable purposes (section 53 of the Fiscal Code).
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Kirchlich" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Die beschränkt steuerpflichtige Person verfolgt kirchliche Zwecke (§ 54 AO).</xs:documentation>
					<xs:documentation xml:lang="en">The person with limited tax liability pursues ecclesiastical purposes (section 54 of the Fiscal Code).
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GemeinnuetzigeZwecke" type="kafe:GemeinnuetzigeZwecke_Struct" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Angaben zu gemeinnützigen Zwecken</xs:documentation>
					<xs:documentation xml:lang="en">Information on the public benefit purposes</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NachweisAnerkennung" type="kafe:Anhang_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Nachweis der Anerkennung der steuerbegünstigten Zwecke im Ansässigkeitsstaat</xs:documentation>
					<xs:documentation xml:lang="en">Upload proof of recognition of the tax-privileged purposes in the country of residence</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Ausschliesslich" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Verfolgt die beschränkt steuerpflichtige Person ausschließlich und unmittelbar ihre steuerbegünstigten
						satzungsmäßigen Zwecke (siehe §§ 56 und 57 AO)?
					</xs:documentation>
					<xs:documentation xml:lang="en">Does the person with limited tax liability serve directly and exclusively tax-privileged purposes (see
						sections 56 and 57 of the Fiscal Code)?
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Beginn" type="xs:date">
				<xs:annotation>
					<xs:documentation xml:lang="de">Beginn der gemeinnützigen, mildtätigen oder kirchlichen Tätigkeit</xs:documentation>
					<xs:documentation xml:lang="en">Start of the public-benefit, charitable or ecclesiastical activity</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
