					<xs:documentation xml:lang="en">Trading day</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Transaktionsart" type="kafe:TransaktionArt_ENUM">
				<xs:annotation>
					<xs:documentation xml:lang="de">Zugang / Abgang</xs:documentation>
					<xs:documentation xml:lang="en">Inflow / Outflow</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Geschaeft" type="kafe:TransaktionGeschaeft_ENUM">
				<xs:annotation>
					<xs:documentation xml:lang="de">Transaktion</xs:documentation>
					<xs:documentation xml:lang="en">Transaction</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Stueckzahl" type="kafe:Stueckzahl_Type">
				<xs:annotation>
					<xs:documentation xml:lang="de">Stückzahl</xs:documentation>
					<xs:documentation xml:lang="en">Number of shares</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VereinbAbwicklungstag" type="xs:date">
				<xs:annotation>
					<xs:documentation xml:lang="de">Vereinbarter Abwicklungstag</xs:documentation>
					<xs:documentation xml:lang="en">Agreed settlement date</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TatsaechlAbwicklungstag" type="xs:date">
				<xs:annotation>
					<xs:documentation xml:lang="de">Tatsächlicher Abwicklungstag</xs:documentation>
					<xs:documentation xml:lang="en">Actual settlement date</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="TransaktionId" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="de">Laufende Nummer der Transaktion, beginnend bei 1</xs:documentation>
				<xs:documentation xml:lang="en">Sequence number of the transaction, starting with 1</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="1"/>
