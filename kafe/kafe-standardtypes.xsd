					<xs:documentation xml:lang="de">Wurde eine Statusbescheinigung nach § 7 Absatz 3 InvStG erteilt oder beantragt?</xs:documentation>
					<xs:documentation xml:lang="en">Has a status certificate pursuant to section 7 (3) Investment Tax Act been issued or applied for?
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Steuerbehoerde" type="kafe:Steuerbehoerden_ENUM" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Ausstellungsbehörde bzw. Behörde, bei der die Statusbescheinigung beantragt wurde</xs:documentation>
					<xs:documentation xml:lang="en">Issuing authority or authority to which the status certificate was applied for</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Aktenzeichen" type="kafe:Stnr_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Ordnungsnummer / Steuernummer (sofern erteilt)</xs:documentation>
					<xs:documentation xml:lang="en">Ordinal number / tax number (if issued)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GueltigVon" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Gültig von</xs:documentation>
					<xs:documentation xml:lang="en">Valid from</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:date">
						<xs:minInclusive value="2018-01-01"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="GueltigBis" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Gültig bis</xs:documentation>
					<xs:documentation xml:lang="en">Valid until</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:date">
						<xs:minInclusive value="2018-01-01"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SteuerbeguenstigteZwecke_Struct">
		<xs:annotation>
			<xs:documentation xml:lang="de">Steuerbegünstigte Zwecke</xs:documentation>
			<xs:documentation xml:lang="en">Tax-privileged purposes</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ZER" type="kafe:ZER_Struct" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Zuwendungsempfängerregister</xs:documentation>
					<xs:documentation xml:lang="en">Register of non-profit organisations authorised to issue donation receipts (Zuwendungsempfängerregister)
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Zwecke" type="kafe:Zwecke_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Angaben zu den steuerbegünstigten Zwecken (§§ 52-54 AO)</xs:documentation>
					<xs:documentation xml:lang="en">Information on the tax-privileged purposes (sections 52-54 of the Fiscal Code)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Satzung" type="kafe:Satzung_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Satzung (§ 60 AO)</xs:documentation>
					<xs:documentation xml:lang="en">Statutes (section 60 of the Fiscal Code)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Inlandsbezug" type="kafe:Inlandsbezug_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Struktureller Inlandsbezug (§ 52 Absatz 2 AO)</xs:documentation>
					<xs:documentation xml:lang="en">Structural connection to Germany (section 51 (2) of the Fiscal Code)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Vermoegensbindung" type="kafe:Vermoegensbindung_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Satzungsmäßige Vermögensbindung (§ 61 AO)</xs:documentation>
					<xs:documentation xml:lang="en">Dedication of assets in the statutes (section 61 of the Fiscal Code)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Geschaeftsfuehrung" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Ist die tatsächliche Geschäftsführung ausschließlich und unmittelbar auf die Erfüllung der
						steuerbegünstigten Zwecke gerichtet und entspricht den Satzungsbestimmungen?
					</xs:documentation>
					<xs:documentation xml:lang="en">Is the actual management directed exclusively and directly towards achieving the tax-privileged purposes and
						does it conform to the provisions on the requirements for tax privileges contained in the statutes?
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Verfassungstreue" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Fördert die beschränkt steuerpflichtige Person Bestrebungen gegen die freiheitlich demokratische
						Grundordnung oder den Bestand oder die Sicherheit der Bundesrepublik Deutschland oder ihrer Länder?
					</xs:documentation>
					<xs:documentation xml:lang="en">Does the person with limited tax liability advance efforts directed against the liberal democratic basic
						order (freiheitliche demokratische Grundordnung) or against the existence or security of the Federal Republic of Germany or its Länder?
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Taetigkeitsbericht" type="kafe:Anhang_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Tätigkeitsbericht oder vergleichbare Nachweise</xs:documentation>
					<xs:documentation xml:lang="en">Activity report or comparable proof</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EinnahmenAusgaben" type="kafe:Anhang_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Aufstellung der Einnahmen und Ausgaben oder Kassenberichte</xs:documentation>
					<xs:documentation xml:lang="en">Statments showing revenue and expenditure or cash statements</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Vermoegen" type="kafe:Anhang_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Vermögensübersicht mit Nachweisen über die Bildung und Entwicklung der Rücklagen</xs:documentation>
					<xs:documentation xml:lang="en">Statement of assets and liabilities with proof of the creation and accumulation of reserves
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Protokolle" type="kafe:Anhang_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Vorstandsprotokolle und Protokolle von Mitglieder- oder Gesellschafterversammlungen</xs:documentation>
					<xs:documentation xml:lang="en">Board minutes and minutes from general or shareholder meetings</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StpflNatP_Struct">
		<xs:annotation>
			<xs:documentation xml:lang="de">Natürliche Person</xs:documentation>
			<xs:documentation xml:lang="en">Natural person</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NatP" type="kafe:NatP_Struct"/>
			<xs:element name="Geburtsdatum">
				<xs:annotation>
					<xs:documentation xml:lang="de">Geburtsdatum</xs:documentation>
					<xs:documentation xml:lang="en">Date of birth</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:date">
						<xs:minInclusive value="1900-01-01"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="StaatsangehoerigkeitDE" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Besitzt die beschränkt steuerpflichtige Person die deutsche Staatsangehörigkeit?</xs:documentation>
					<xs:documentation xml:lang="en">Does the person with limited tax liability have German citizenship?</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StaatsangehoerigkeitKW" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Besitzt die beschränkt steuerpflichtige Person die kuwaitische Staatsangehörigkeit?</xs:documentation>
					<xs:documentation xml:lang="en">Does the person with limited tax liability have Kuwaiti citizenship?</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StaatsangehoerigkeitCH" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Besitzt die beschränkt steuerpflichtige Person die schweizerische Staatsangehörigkeit?</xs:documentation>
					<xs:documentation xml:lang="en">Does the person with limited tax liability have Swiss citizenship?</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StpflNichtNatP_Struct">
		<xs:annotation>
			<xs:documentation xml:lang="de">Nicht natürliche Person</xs:documentation>
			<xs:documentation xml:lang="en">Non-natural person</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NichtNatP" type="kafe:NichtNatP_Struct"/>
			<xs:element name="Gruendungsdatum">
				<xs:annotation>
					<xs:documentation xml:lang="de">Gründungsdatum</xs:documentation>
					<xs:documentation xml:lang="en">Date of incorporation</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:date">
						<xs:minInclusive value="1800-01-01"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="RechtsformAuspraegung">
				<xs:annotation>
					<xs:documentation xml:lang="de">Ausprägung der Rechtsform</xs:documentation>
					<xs:documentation xml:lang="en">specific legal form</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="80"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Gruendungsstaat" type="kafe:CountryISOAlpha2_ENUM" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Staat, nach dessen Recht die Organisation/Gesellschaft gegründet wurde.</xs:documentation>
					<xs:documentation xml:lang="en">Country under whose law the organisation/company is incorporated</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Geschaeftsleitung" type="kafe:Geschaeftsleitung_Struct">
				<xs:annotation>
					<xs:documentation xml:lang="de">Geschäftsleitung</xs:documentation>
					<xs:documentation xml:lang="en">Management</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LEI" type="kafe:LEI_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Legal Entity Identifier (LEI)</xs:documentation>
					<xs:documentation xml:lang="en">Legal Entity Identifier (LEI)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Register" type="kafe:Registereintragung_Struct" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Registereintragung</xs:documentation>
					<xs:documentation xml:lang="en">Entry in the register</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Boerse" type="kafe:Boersenhandel_Struct" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Börsenhandel</xs:documentation>
					<xs:documentation xml:lang="en">Stock exchange trading details</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
