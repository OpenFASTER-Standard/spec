			<xs:documentation xml:lang="de">Transaktionen</xs:documentation>
			<xs:documentation xml:lang="en">Transactions</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Transaktion" type="kafe:Transaktion_Struct" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="de">Transaktion</xs:documentation>
					<xs:documentation xml:lang="en">Transaction</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Transaktionsdaten_Struct">
		<xs:annotation>
			<xs:documentation xml:lang="de">Transaktionsdaten</xs:documentation>
			<xs:documentation xml:lang="en">Transaction data</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Depot" type="kafe:Depot_Struct" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="de">Depot</xs:documentation>
					<xs:documentation xml:lang="en">Deposit</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UnselbstArbeit_Struct">
		<xs:sequence>
			<xs:element name="UnselbstArbeit" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Ist die beschränkt steuerpflichtige Person in der Schweiz ansässig geworden, um dort eine echte
						unselbständige Arbeit auszuüben?
					</xs:documentation>
					<xs:documentation xml:lang="en">Has the person with limited tax liability become resident in Switzerland, in order to pursue genuine
						employment there?
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Arbeitgeber" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Name und Anschrift des Arbeitgebers</xs:documentation>
					<xs:documentation xml:lang="en">Name and address of the employer</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="500"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Arbeitgeberbescheinigung" type="kafe:Anhang_Struct" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Bestätigung des Arbeitgebers über die echte unselbständige Arbeit beigefügt</xs:documentation>
					<xs:documentation xml:lang="en">Employer’s confirmation of genuine dependent employment is enclosed</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InteresseArbeitgeber" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Ist die beschränkt steuerpflichtige Person am Arbeitgeber beteiligt oder in anderer Weise wirtschaftlich
						wesentlich interessiert (z. B. partiarisches Darlehen)?
					</xs:documentation>
					<xs:documentation xml:lang="en">Does the person with limited tax liability have an interest in the employer or another significant economic
						interest (e.g. a participating loan)?
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InteresseBeschreibung" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Bitte beschreiben</xs:documentation>
					<xs:documentation xml:lang="en">Please describe</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="500"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Zuzugsdatum" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Wann erfolgte der Zuzug in die Schweiz?</xs:documentation>
					<xs:documentation xml:lang="en">When did the move to Switzerland take place?</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:date">
						<xs:minInclusive value="1900-01-01"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Zuzugsgruende" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="de">Aus welchen Gründen erfolgte der Zuzug in die Schweiz?</xs:documentation>
					<xs:documentation xml:lang="en">What were the reasons for moving to Switzerland?</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="500"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Vermoegensbindung_Struct">
		<xs:annotation>
			<xs:documentation xml:lang="de">Satzungsmäßige Vermögensbindung (§ 61 AO)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="KoerperschaftDE" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Das Vermögen fällt im Falle der Auflösung oder Aufhebung der beschränkt steuerpflichtigen Person oder bei
						Wegfall ihres bisherigen Zwecks - zumindest zum Teil - einer in Deutschland ansässigen steuerbegünstigten Körperschaft für
						steuerbegünstigte Zwecke zu.
					</xs:documentation>
					<xs:documentation xml:lang="en">If the person with limited tax liabiliy is dissolved or liquidated or if its former purpose ceases, the
						assets accrue - at least in part - to a tax-privileged corporation resident in Germany for tax-privileged purposes.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KoerperschaftKStG" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Das Vermögen fällt im Falle der Auflösung oder Aufhebung der beschränkt steuerpflichtigen Person oder bei
						Wegfall ihres bisherigen Zwecks - zumindest zum Teil - einer in § 5 Absatz 2 Nr. 2 KStG genannten Körperschaft für steuerbegünstigte
						Zwecke zu.
					</xs:documentation>
					<xs:documentation xml:lang="en">If the person with limited tax liabiliy is dissolved or liquidated or if its former purpose ceases, the
						assets accrue - at least in part - to one of the corporations listed in section 5 (2) of the Corporation Tax Act for tax-privileged
						purposes.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KoerperschaftOeRecht" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Das Vermögen fällt im Falle der Auflösung oder Aufhebung der beschränkt steuerpflichtigen Person oder bei
						Wegfall ihres bisherigen Zwecks - zumindest zum Teil - einer juristischen Person des öffentlichen Rechts für steuerbegünstigte Zwecke
						zu.
					</xs:documentation>
					<xs:documentation xml:lang="en">If the person with limited tax liabiliy is dissolved or liquidated or if its former purpose ceases,the
						assets accrue - at least in part - to a legal person under public law for tax-privileged purposes.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Andere" type="xs:boolean">
				<xs:annotation>
					<xs:documentation xml:lang="de">Das Vermögen fällt im Falle der Auflösung oder Aufhebung der beschränkt steuerpflichtigen Person oder bei
						Wegfall ihres bisherigen Zwecks - zumindest zum Teil - einer anderen Person zu.
					</xs:documentation>
					<xs:documentation xml:lang="en">If the person with limited tax liabiliy is dissolved or liquidated or if its former purpose ceases,the
						assets accrue - at least in part - to another person.
