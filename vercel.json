{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/documentation/about" }
  ],
  "headers": [
    {
      "source": "/:path((?!.*\\.(xlsx|pdf)$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
